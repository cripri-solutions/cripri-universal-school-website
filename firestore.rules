rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPlatformReviewer() {
      return signedIn() && request.auth.token.platformAdmin == true;
    }

    function schoolIsActive(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.status == 'ACTIVE';
    }

    function belongsToActiveSchool(schoolId) {
      return signedIn()
        && request.auth.token.schoolId == schoolId
        && schoolIsActive(schoolId);
    }

    function isSchoolAdmin(schoolId) {
      return belongsToActiveSchool(schoolId)
        && request.auth.token.role == 'SCHOOL_ADMIN';
    }

    // Applicants may submit only their own pending application.
    // Only trusted CRIPRI reviewers may read or decide applications.
    match /schoolApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'PENDING_REVIEW'
        && request.resource.data.keys().hasOnly([
          'applicantUid', 'schoolName', 'schoolCategory', 'country',
          'region', 'officialEmail', 'officialPhone', 'address',
          'contactName', 'contactRole', 'status', 'submittedAt'
        ]);
      allow read, update, delete: if isPlatformReviewer();
    }

    // School records and membership roles are provisioned by trusted processes.
    match /schools/{schoolId} {
      allow read: if isPlatformReviewer()
        || (resource.data.status == 'ACTIVE'
            && (resource.data.publicProfileEnabled == true
                || belongsToActiveSchool(schoolId)));
      allow create, update, delete: if isPlatformReviewer();

      // Visitors can read only published content from an active school.
      // A school administrator can read drafts, withdrawn and recovered items.
      // All client writes are denied: callable backend functions validate roles,
      // enforce lifecycle transitions and write the audit record atomically.
      match /siteContent/{contentId} {
        allow read: if isPlatformReviewer()
          || (schoolIsActive(schoolId) && resource.data.status == 'PUBLISHED')
          || isSchoolAdmin(schoolId);
        allow create, update, delete: if false;
      }

      // Immutable audit history: school admins and platform reviewers may read.
      // Only trusted server-side functions may create audit entries.
      match /contentAudit/{auditId} {
        allow read: if isPlatformReviewer() || isSchoolAdmin(schoolId);
        allow create, update, delete: if false;
      }

      // Private school data remains closed until separately designed and tested.
      match /privateData/{document=**} {
        allow read, write: if false;
      }

      match /members/{uid} {
        allow read: if isPlatformReviewer()
          || (signedIn() && request.auth.uid == uid
              && belongsToActiveSchool(schoolId));
        allow create, update, delete: if isPlatformReviewer();
      }
    }

    match /users/{uid} {
      allow read: if isPlatformReviewer()
        || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isPlatformReviewer();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}